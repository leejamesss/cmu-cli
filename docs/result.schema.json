{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "cmu-cli result envelope 1.0",
  "type": "object",
  "required": [
    "schema_version",
    "command",
    "status",
    "complete",
    "retrieved_at",
    "sources",
    "warnings",
    "error",
    "data"
  ],
  "properties": {
    "schema_version": {
      "const": "1.0"
    },
    "command": {
      "type": [
        "string",
        "null"
      ]
    },
    "status": {
      "enum": [
        "ok",
        "partial",
        "error"
      ]
    },
    "complete": {
      "type": "boolean"
    },
    "retrieved_at": {
      "type": "string",
      "format": "date-time"
    },
    "sources": {
      "type": "array"
    },
    "warnings": {
      "type": "array"
    },
    "error": {
      "type": [
        "object",
        "null"
      ]
    },
    "data": {
      "type": [
        "array",
        "object",
        "null"
      ]
    }
  },
  "additionalProperties": false,
  "allOf": [
    {
      "if": {
        "properties": {
          "command": {
            "const": "demo"
          },
          "status": {
            "const": "ok"
          }
        }
      },
      "then": {
        "properties": {
          "data": {
            "type": "object",
            "required": [
              "synthetic",
              "network_used",
              "statuses",
              "file",
              "sha256",
              "assignments",
              "exports",
              "assignment_index",
              "announcement_index"
            ],
            "properties": {
              "synthetic": {
                "const": true
              },
              "network_used": {
                "const": false
              },
              "statuses": {
                "const": [
                  "downloaded",
                  "unchanged"
                ]
              },
              "file": {
                "type": "string"
              },
              "sha256": {
                "type": "string",
                "pattern": "^[a-f0-9]{64}$"
              },
              "assignments": {
                "type": "array",
                "items": {
                  "type": "object",
                  "required": [
                    "name",
                    "submitted"
                  ],
                  "properties": {
                    "name": {
                      "type": "string"
                    },
                    "submitted": {
                      "type": [
                        "boolean",
                        "null"
                      ]
                    }
                  }
                }
              },
              "exports": {
                "type": "array",
                "items": {
                  "type": "string"
                }
              },
              "assignment_index": {
                "type": "string"
              },
              "announcement_index": {
                "type": "string"
              }
            }
          }
        }
      }
    },
    {
      "if": {
        "properties": {
          "status": {
            "const": "ok"
          }
        }
      },
      "then": {
        "properties": {
          "complete": {
            "const": true
          },
          "error": {
            "type": "null"
          },
          "data": {
            "type": [
              "object",
              "array"
            ]
          }
        }
      }
    },
    {
      "if": {
        "properties": {
          "status": {
            "const": "partial"
          }
        }
      },
      "then": {
        "properties": {
          "complete": {
            "const": false
          },
          "error": {
            "type": "null"
          },
          "data": {
            "type": [
              "object",
              "array"
            ]
          }
        }
      }
    },
    {
      "if": {
        "properties": {
          "status": {
            "const": "error"
          }
        }
      },
      "then": {
        "properties": {
          "complete": {
            "const": false
          },
          "error": {
            "type": "object",
            "required": [
              "code",
              "message"
            ],
            "properties": {
              "code": {
                "type": "string"
              },
              "message": {
                "type": "string"
              }
            }
          },
          "data": {
            "type": "null"
          }
        }
      }
    },
    {
      "if": {
        "properties": {
          "command": {
            "const": "auth"
          },
          "status": {
            "const": "partial"
          }
        }
      },
      "then": {
        "properties": {
          "data": {
            "type": "object",
            "required": [
              "metadata_valid",
              "registration_verified",
              "oauth_implemented",
              "network_used",
              "credentials_read",
              "blockers"
            ],
            "properties": {
              "metadata_valid": {
                "const": true
              },
              "registration_verified": {
                "const": false
              },
              "oauth_implemented": {
                "const": false
              },
              "network_used": {
                "const": false
              },
              "credentials_read": {
                "const": false
              },
              "blockers": {
                "type": "array",
                "minItems": 1,
                "items": {
                  "type": "string"
                }
              }
            }
          }
        }
      }
    }
  ]
}
